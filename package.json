{
  "name": "whisper2opencode",
  "version": "1.0.0",
  "description": "OpenCode v1 plugin for audio transcription using whisper.cpp JS bindings",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && bun run lint && bun run type-check && bun run test && bun run copy-markdowns",
    "copy-markdowns": "bun run ./scripts/copy-markdowns.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:file": "eslint",
    "local-install": "bun run build && opencode plugin \"$(pwd)\" --global --force",
    "prepack": "bun run build",
    "prettify": "prettier --write .",
    "test": "bun test src",
    "type-check": "bun tsc && bun tsc -p src/__tests__/tsconfig.json"
  },
  "keywords": [
    "opencode",
    "plugin",
    "whisper",
    "voice-to-text",
    "speech recognition"
  ],
  "author": {
    "name": "Dawid Paluchowski",
    "email": "palucdev@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/palucdev/whisper2opencode.git"
  },
  "homepage": "https://github.com/palucdev/whisper2opencode#readme",
  "bugs": {
    "url": "https://github.com/palucdev/whisper2opencode/issues"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.19.5",
    "ffmpeg-static": "^5.3.0",
    "gray-matter": "^4.0.3",
    "whisper.cpp": "^1.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.13",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^79.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.3.0"
  }
}
