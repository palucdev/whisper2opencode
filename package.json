{
  "name": "whisper2opencode",
  "version": "0.1.0",
  "description": "OpenCode v1 plugin for audio transcription using whisper.cpp JS bindings",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "local-install": "bun run build && opencode plugin \"$(pwd)\" --global --force",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/transcribe.test.js"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.19.5",
    "ffmpeg-static": "^5.3.0",
    "whisper.cpp": "^1.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "opencode",
    "plugin",
    "whisper",
    "voice-to-text",
    "speech recognition"
  ],
  "author": {
    "name": "Dawid Paluchowski",
    "email": "palucdev@gmail.com"
  }
}
